# Ignore development files
node_modules/
.git/
.gitignore
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore client source files (we only need the built version)
# client/src/ - commented out because we need source files for building
# client/public/ - needed for React build process
client/node_modules/

# Ignore server development files  
server/node_modules/

# Ignore existing build files (will be rebuilt in container)
public/
client/build/

# Ignore test files
tests/
*.test.js
*.spec.js

# Ignore documentation
docs/
*.md

# Ignore local environment files
.env.local
.env.development
.env.test

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db
