{
  "name": "trek-iq",
  "version": "1.0.0",
  "description": "Accessibility-focused routing and data visualization web app for Halifax",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build && npm run copy:build",
    "copy:build": "mkdir -p public && cp -r client/build/* public/",
    "railway:build": "npm install && cd client && npm install && npm run build && cp -r client/build/* public/",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "network": "node start-network.js",
    "test:network": "node test-network-config.js",
    "download:accessibility": "node scripts/downloadAccessibilityData.js",
    "update:data": "npm run download:accessibility"
  },
  "keywords": [
    "accessibility",
    "routing",
    "halifax",
    "geojson",
    "leaflet"
  ],
  "author": "Trek.IQ Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "lru-cache": "^10.0.1",
    "sqlite3": "^5.1.7",
    "cross-env": "^7.0.3"
  }
}
